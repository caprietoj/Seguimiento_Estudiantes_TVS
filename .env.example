APP_NAME="Seguimiento de Estudiantes"
APP_ENV=production
# Genera uno nuevo con: docker compose exec app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
# URL pública de la aplicación. Debe usar https:// en producción (cookies seguras, CSRF).
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# stderr: los logs van a la salida estándar del contenedor (ver sección 9 del README), sin datos de estudiantes.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=seguimiento_estudiantes
DB_USERNAME=seguimiento
DB_PASSWORD=

SESSION_DRIVER=database
# Expiración de sesión por inactividad, en minutos (decisión de la sección 3).
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS, deja esto en true.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# "local" guarda las fotos en storage/app/private/fotos, servidas por una ruta autenticada.
# Cambia a "s3" (y llena las variables AWS_*) para usar un almacenamiento externo sin tocar código.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sin SMTP configurado, el enlace "Olvidé mi contraseña" y el envío de la contraseña temporal
# por correo quedan apagados (ver sección 3): el ADMIN entrega la contraseña temporal en pantalla.
# Configura MAIL_* para activarlos. En desarrollo, Mailpit (ver docker-compose.yml) usa MAIL_HOST=mailpit.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-responder@colegio.edu.co"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Seguimiento de Estudiantes (config/seguimiento.php) ---
# Si un usuario EMC puede escribir las notas clínicas del Dpto. de apoyo (por defecto, solo las lee; Psicología las escribe).
SEGUIMIENTO_EMC_ESCRIBE_NOTAS_CLINICAS=false
# Si un usuario EMC con sección asignada (users.emc_section_id) se limita a esa sección.
SEGUIMIENTO_EMC_LIMITA_POR_SECCION=true
# Tamaño máximo por archivo para el asistente de migración, en MB.
MIGRACION_MAX_MB=20

# --- MySQL (solo lo usa docker-compose.prod.yml para crear el contenedor de base de datos) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=seguimiento_estudiantes
MYSQL_USER=seguimiento
MYSQL_PASSWORD=

# --- Publicación en Docker Hub (solo la usa el pipeline de CI, no la aplicación) ---
DOCKERHUB_REPO=organizacion/seguimiento-estudiantes
